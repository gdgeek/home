# 品牌选择：本地开发使用 URL 参数 ?brand=xingkou|xiading|xrugc|mrpp
# Docker 运行时可选设置 BRAND_ID 来锁定单品牌；不设置时按访问域名自动选择。

# WordPress API URL
VITE_WORDPRESS_API_URL=http://localhost:8080/wp-json/wp/v2

# 后端API URL
VITE_BACKEND_API_URL=http://localhost:3000/api

# 工作台 URL
VITE_WORKBENCH_URL=https://d.xiading.hxgxonline.com/

# MySQL 配置 (Docker Compose 使用)
MYSQL_ROOT_PASSWORD=root_password
MYSQL_DATABASE=wordpress
MYSQL_USER=wordpress
MYSQL_PASSWORD=wordpress_password
