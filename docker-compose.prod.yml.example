# 生产环境 docker-compose 配置示例
#
# 默认根据访问域名选择品牌：
#   mrpp.com / *.mrpp.com       → mrpp
#   xrugc.com / *.xrugc.com     → xrugc
#   ar-creator.cn / *.ar-creator.cn → xingkou
#   xiading.hxgxonline.com / *.xiading.hxgxonline.com → xiading
#
# 可选：设置 BRAND_ID 锁定单品牌
#   BRAND_ID=xingkou  → 星扣（简体中文，大陆市场）
#   BRAND_ID=xiading   → 夏鼎（繁体中文，澳门市场）
#   BRAND_ID=xrugc     → XRUGC
#   BRAND_ID=mrpp      → MRPP

version: "3.8"

services:
  frontend:
    image: ccr.ccs.tencentyun.com/your-namespace/ar-home:latest
    ports:
      - "80:80"
    environment:
      - WORKBENCH_URL=https://your-workbench-url.com/
    restart: unless-stopped

  wordpress:
    image: wordpress:latest
    depends_on:
      - db
    ports:
      - "8080:80"
    environment:
      WORDPRESS_DB_HOST: db:3306
      WORDPRESS_DB_USER: wordpress
      WORDPRESS_DB_PASSWORD: your_password
      WORDPRESS_DB_NAME: wordpress
    volumes:
      - blog-data:/var/www/html
    restart: unless-stopped

  db:
    image: mysql:8.0
    volumes:
      - sql-data:/var/lib/mysql
    environment:
      MYSQL_ROOT_PASSWORD: your_root_password
      MYSQL_DATABASE: wordpress
      MYSQL_USER: wordpress
      MYSQL_PASSWORD: your_password
    restart: unless-stopped

volumes:
  sql-data:
  blog-data:
